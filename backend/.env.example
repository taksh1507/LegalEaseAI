NODE_ENV=development
HOST=127.0.0.1
PORT=5000
# Set your local PostgreSQL connection URL. Keep the actual password out of Git.
DATABASE_URL=
# Enable verified TLS for hosted databases; Neon hosts enable it automatically.
DATABASE_SSL=false
PG_POOL_MAX=10
# Unique random value of at least 32 characters. No fallback is accepted.
JWT_SECRET=
# Schema changes are explicit by default: npm run db:migrate
AUTO_MIGRATE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Configure only when your deployment has this exact number of trusted proxy hops.
TRUST_PROXY_HOPS=0
API_RATE_LIMIT=200
AUTH_RATE_LIMIT=30
DOCUMENT_RATE_LIMIT=30
MAX_DOCUMENT_CHARS=60000
AI_TIMEOUT_MS=30000
OPENAI_ROUTER_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_REQUIRE_TLS=true
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE=OTP1
DEFAULT_COUNTRY_CODE=+91
# Set this to an installed Chromium/Chrome path, or install Puppeteer's browser.
PUPPETEER_EXECUTABLE_PATH=
PDF_MAX_CONCURRENCY=2
# Only for isolated development/test containers that cannot use Chromium's sandbox.
# Keep false in production and verify the deployment's sandbox support.
PDF_DISABLE_SANDBOX=false
