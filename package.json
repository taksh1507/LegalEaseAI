{
  "name": "legalease-ai",
  "version": "1.0.0",
  "description": "AI-powered legal document analysis tool",
  "private": true,
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "framer-motion": "^10.16.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.14",
    "concurrently": "^9.2.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.0.0",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.0",
    "vite": "^8.3.8"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src vite.config.mjs",
    "test": "npm --prefix backend test",
    "dev": "concurrently \"npm start\" \"npm --prefix backend run dev\"",
    "install-all": "npm ci && npm --prefix backend ci",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
